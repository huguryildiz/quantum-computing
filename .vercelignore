# The host builds the site with `node web/build-site.js`, from `build/src`, the
# tracked PDFs in `dist/` and the cover page in `web/`. Nothing else is needed,
# and the first entries must never leave this machine.
source/
.venv/
.claude/
shots/
pages/
site/
textclash.json
*.tmp

# Instructor material is not published.
dist/Instructor_Solutions.*

# The pin for the numerical suite in verify/, which does not run on the host.
# Left there it makes the platform read the project as a Python application
# and the deploy fails looking for an entrypoint.
requirements.txt
