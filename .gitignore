# --- macOS ---
.DS_Store
._*
.Spotlight-V100
.Trashes

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# --- Node ---
node_modules/

# --- Third-party source material (kept on disk, never tracked) ---
# source/ is a clone of the open course this one adapts. It is the syllabus,
# never redistributed from here. The whole directory, not file by file, so a
# new subdirectory is not let in by default. A fresh clone will not contain it.
source/

# --- Pipeline output that is not a deliverable ---
# notes/build.js and notes/editions.js write these so notes/topdf.js can turn them
# into PDFs. They are intermediates, regenerated by one command each.
dist/Lecture_Notes.html
dist/Student_Workbook.html
dist/Instructor_Solutions.html
dist/Formula_Reference.html
# The lecture notes, student workbook and formula reference PDFs are published
# deliverables and stay tracked. The instructor edition is not published at all.
dist/Instructor_Solutions.*
# build/qa.js and build/shot.js screenshot dumps and build/textclash.js report.
shots/
shots-m/
textclash.json
# pdftoppm renders, made for visual audits.
pages/

# --- Scratch ---
_to_delete/
*.tmp
*.log

# impeccable design tool: config.json is tracked; caches and local overrides are not.
.impeccable/*
!.impeccable/config.json
/.impeccable.md

# Local working area. The agent instructions and guards are tracked; commands,
# plans, specs, notes, references, and other working records remain ignored.
.claude/*
!.claude/README.md
!.claude/settings.json
!.claude/rules/
!.claude/hooks/
.claude/hooks/__pycache__/

# FUSE mount leftovers
.fuse_hidden*

# The root instruction files are tracked; ignore copies anywhere else.
CLAUDE.md
AGENTS.md
DESIGN.md
PRODUCT.md
!/CLAUDE.md
!/AGENTS.md
!/DESIGN.md
!/PRODUCT.md

# Editor settings: a local convenience, not a property of the project.
.vscode/

# --- Public site build (web/build-site.js) ---
# Assembled from dist/ and web/ on every deploy; nothing in it is authored by hand.
site/
.vercel
.env*

# Working TODO: local working document, not tracked.
TODO.md
