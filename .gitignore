# --- macOS ---
.DS_Store
._*
.Spotlight-V100
.Trashes

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# --- Node ---
node_modules/

# --- Large / restricted source material (kept on disk, never tracked) ---
# Third-party and oversized source material. Never redistributed, never in
# history. The whole directory, not file by file, so a new subdirectory is not
# let in by default. A fresh clone will not contain any of it.
source/

# --- Pipeline output that is not a deliverable ---
# notes/build.js and notes/editions.js write these so notes/topdf.js can turn them
# into PDFs. They are intermediates, regenerated by one command each.
dist/Lecture_Notes.html
dist/Student_Workbook.html
dist/Instructor_Solutions.html
dist/Formula_Reference.html
# The lecture notes, student workbook and formula reference PDFs are published
# deliverables and stay tracked. The instructor edition is not published at all.
dist/Instructor_Solutions.*
# build/qa.js screenshot dumps and build/textclash.js report.
shots/
shots-m/
textclash.json
# pdftoppm renders of the source pages, made for the visual audit.
pages/

# --- Scratch ---
_to_delete/
*.tmp
*.log

# Local working area. Here the whole directory stays local, as it always has in
# this repository: prompts, plans, reports and the agent instructions.
.claude/
.Codex/notes/

# The agent instruction files are local in this repository; the design and
# product documents are tracked at the root.
CLAUDE.md
AGENTS.md
DESIGN.md
PRODUCT.md
!/DESIGN.md
!/PRODUCT.md

# FUSE mount leftovers
.fuse_hidden*

# Editor settings: a local convenience, not a property of the project.
.vscode/

# --- Public site build (web/build-site.js) ---
# Assembled from dist/ and web/ on every deploy; nothing in it is authored by hand.
site/
.vercel
.env*

# Working TODO: local working document, not tracked.
TODO.md
