# Third-party and oversized source material. Never redistributed, never in history.
source/

# Generated intermediates. The HTML editions are rebuilt from the sources and
# duplicate the printed ones beside them, so only the printed editions are
# tracked — and the instructor edition is not published at all.
dist/Lecture_Notes.html
dist/Student_Workbook.html
dist/Formula_Reference.html
dist/Instructor_Solutions.*

# Local working area, not student-facing. The commands that drive production
# live here too, and they are instructions to whoever is building this rather
# than part of what is built — the same reason AGENTS.md and CLAUDE.md are out.
.claude/

# Local toolchain and scratch output.
.venv/
node_modules/
shots/
shots-m/
pages/
textclash.json
__pycache__/
.pytest_cache/

.DS_Store
.vercel

# Working notes for the agents that build this, not part of what is published.
AGENTS.md
CLAUDE.md
.Codex/notes/
